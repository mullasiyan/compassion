# LostLink Backend Environment Configuration
PORT=8000
DEBUG=True

# Google Gemini API Key (Leave empty to use verified cached response fallback)
GEMINI_API_KEY=your_gemini_api_key_here

# OpenStreetMap User Agent (Required by Nominatim Usage Policy)
NOMINATIM_USER_AGENT=LostLink-SearchRescue/1.0 (contact: info@lostlink.org)
